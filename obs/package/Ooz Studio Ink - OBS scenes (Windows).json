  {
   "name": "YouTube Chat",
   "uuid": "aaca3448-5d4d-5b05-abe1-672f3306aef8",
   "id": "browser_source",
   "versioned_id": "browser_source",
   "settings": {
    "is_local_file": false,
    "url": "https://www.youtube.com/live_chat?is_popout=1&v=PASTE_YOUR_VIDEO_ID",
    "width": 544,
    "height": 878,
    "fps_custom": false,
    "reroute_audio": false,
    "restart_when_active": false,
    "shutdown": false,
    "css": "/* YouTube chat in the Ooz Studio Ink look (paste into the chat source's Custom CSS if it's ever reset) */\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@500;700&display=swap');\nbody, yt-live-chat-app, yt-live-chat-renderer { background: rgba(13,13,13,0.92) !important; overflow: hidden !important; }\nyt-live-chat-header-renderer, #panel-pages, yt-live-chat-message-input-renderer, #input-panel,\nyt-live-chat-viewer-engagement-message-renderer, #ticker, yt-live-chat-banner-manager,\n#author-photo, #chat-badges, yt-live-chat-author-badge-renderer, #menu, #reaction-control-panel-overlay { display: none !important; }\nyt-live-chat-text-message-renderer { padding: 6px 16px !important; font-family: Inter, Arial, sans-serif !important; }\nyt-live-chat-text-message-renderer #author-name { color: #e2786c !important; font-weight: 700 !important; font-size: 19px !important; }\nyt-live-chat-text-message-renderer #author-name[type=\"owner\"] { color: #f5f4f0 !important; background: #c0392b !important; padding: 2px 6px !important; }\nyt-live-chat-text-message-renderer #message { color: #f5f4f0 !important; font-weight: 500 !important; font-size: 21px !important; line-height: 1.35 !important; }\nyt-live-chat-paid-message-renderer #card { background: #c0392b !important; }\n#item-scroller { overflow: hidden !important; }\n"
   },
